    { "say": "не понимаю", "as": "student", "expect": "минимум 20" },
    { "say": "Сделайте за меня лабу по пределам", "as": "student", "expect": "не принимается" },
    { "say": "Не понимаю, как раскрывать неопределённость 0/0", "as": "student", "expect": "Шаг 2 из 3" },
    { "say": "ничего", "as": "student", "expect": "не принимаются" },
    { "say": "Прочитал лекцию и разобрал два примера из семинара, но на третьем застрял.", "as": "student", "expect": "Шаг 3 из 3" },
    { "tap_label": "2 · понимаю условие, не знаю с чего начать", "as": "student", "expect_button": "Заполнить / изменить чек-лист" },
    { "tap_label": "☑️ Заполнить / изменить чек-лист", "as": "student", "expect": "Чек-лист · пункт 1/2" },
    { "expect_db": "select count(*) from session_bookings b join mentoring_sessions s on s.id=b.session_id where s.creation_key='demo-book'", "equals": [1] },
    { "expect_db": "select count(*) from session_bookings where tried like '%застрял%'", "equals": [1], "as": "student" },
    { "sleep": 1 },
    { "expect": "Чек-лист · пункт 1/2", "as": "student" },
    { "tap_first": 0, "as": "student", "expect": "пункт 2/2" },
    { "tap_first": 0, "as": "student", "expect": "Чек-лист занятия", "expect_button": "К занятию" },
    { "expect_db": "select count(*) from session_bookings b join mentoring_sessions s on s.id=b.session_id where s.creation_key='demo-book' and b.self_rating=2", "equals": [1] }
