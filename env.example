# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# На Railway: ${{Postgres.DATABASE_URL}}   Локально, например: postgresql://postgres@localhost/hm
DATABASE_URL=postgresql://user:pass@host:5432/db
# Telegram ID через запятую. Узнать свой: команда /myid в боте
COORDINATOR_IDS=111111111
LEAD_IDS=222222222
# true — руководитель получает уведомление о каждом обращении, а не только эскалации
LEAD_GETS_ALL=false
DAILY_LIMIT=5
TIMEZONE=Asia/Almaty
# Еженедельная сводка: день недели (0 = понедельник) и час по TIMEZONE
REPORT_WEEKDAY=0
REPORT_HOUR=9
# Необязательно. Если не задан — выводится из BOT_TOKEN. При смене токена без SECRET_KEY
# старые коды доступа к анонимным обращениям перестанут работать.
SECRET_KEY=
